#!/usr/bin/env bash
# ==============================================================================
# lizarbe-update: Wrapper oficial hacia 'lizarbe update'
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    if command -v lizarbe &>/dev/null; then
        exec lizarbe help
    elif [[ -x "$SCRIPT_DIR/lizarbe" ]]; then
        exec "$SCRIPT_DIR/lizarbe" help
    fi
fi

if command -v lizarbe &>/dev/null; then
    exec lizarbe update "$@"
elif [[ -x "$SCRIPT_DIR/lizarbe" ]]; then
    exec "$SCRIPT_DIR/lizarbe" update "$@"
elif [[ -x "/usr/local/bin/lizarbe" ]]; then
    exec "/usr/local/bin/lizarbe" update "$@"
fi

echo "Error: No se encontró la herramienta 'lizarbe'." >&2
exit 1
